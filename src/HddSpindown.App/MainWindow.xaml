<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HddSpindown.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HddSpindown.App"
    Title="HDD Spindown">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (caption buttons stay native) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="Assets/HDD-Spindown.png" Width="16" Height="16" />
                <TextBlock Text="HDD Spindown" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleState" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="32,4,32,24" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Festplatten" Style="{StaticResource TitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="Summary" Text="Verbindung zum Dienst wird hergestellt …" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="ServiceOk" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Die Sperren hält der Windows-Dienst. Dieses Fenster kann geschlossen werden; pausierte HDDs bleiben pausiert.">
                            <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Dienst aktiv" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Click="Refresh_Click" ToolTipService.ToolTip="HDDs neu einlesen (pausierte HDDs werden nicht abgefragt)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Neu einlesen" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReleaseAllButton" Click="ReleaseAll_Click" IsEnabled="False" ToolTipService.ToolTip="Alle pausierten HDDs nacheinander freigeben">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE785;" FontSize="14" />
                            <TextBlock Text="Alle freigeben" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" ToolTipService.ToolTip="Weitere Optionen" AutomationProperties.Name="Weitere Optionen">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Diagnose anzeigen" Click="Diagnostics_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="LegacyMenuItem" Text="Zuordnungen aus Version 0.3 übernehmen" Click="Legacy_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Über HDD Spindown" Click="About_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Service state -->
            <InfoBar x:Name="ServiceBar" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Informational"
                     Title="Dienst" Message="Verbindung wird hergestellt …" Margin="0,0,0,8" />

            <!-- Result of the last action -->
            <InfoBar x:Name="ResultBar" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="0,0,0,8" />

            <!-- Disk cards -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Padding="0,0,12,0">
                <StackPanel Spacing="4">
                    <ItemsRepeater x:Name="DiskList" ItemsSource="{x:Bind Disks}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:DiskItem">
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <Grid ColumnSpacing="16" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Width="40" Height="40" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xEDA2;" FontSize="28" Foreground="{x:Bind IconBrush, Mode=OneWay}" />
                                            <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                     Fill="{x:Bind StateBrush, Mode=OneWay}" Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Model, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind ModelTip, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind StateBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Three separate facts: access, Explorer visibility, hardware -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center" ColumnSpacing="20" Visibility="{x:Bind ShowFacts, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="128" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Zugriff" Style="{StaticResource FactLabelStyle}" />
                                                <TextBlock Text="{x:Bind AccessText, Mode=OneWay}" Style="{StaticResource FactValueStyle}" ToolTipService.ToolTip="{x:Bind AccessText, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Explorer" Style="{StaticResource FactLabelStyle}" />
                                                <TextBlock Text="{x:Bind ExplorerText, Mode=OneWay}" Style="{StaticResource FactValueStyle}" ToolTipService.ToolTip="{x:Bind ExplorerText, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Hardware" Style="{StaticResource FactLabelStyle}" />
                                                <TextBlock Text="{x:Bind HardwareText, Mode=OneWay}" Style="{StaticResource FactValueStyle}" ToolTipService.ToolTip="{x:Bind HardwareTip, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>

                                        <Button Grid.Column="3" MinWidth="112" VerticalAlignment="Center"
                                                Style="{x:Bind ActionStyle, Mode=OneWay}"
                                                IsEnabled="{x:Bind ActionEnabled, Mode=OneWay}"
                                                Click="{x:Bind Invoke}"
                                                AutomationProperties.Name="{x:Bind ActionAutomationName, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind ActionTip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="{x:Bind ActionGlyph, Mode=OneWay}" FontSize="14" />
                                                <TextBlock Text="{x:Bind ActionText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{x:Bind Note, Mode=OneWay}"
                                                   Visibility="{x:Bind HasNote, Mode=OneWay}" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind NoteBrush, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="0,24,0,0" HorizontalAlignment="Center"
                               Text="Keine SATA-HDDs gefunden. SSDs und NVMe-Laufwerke werden nicht angezeigt."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="2,16,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="„Schlafen“ sperrt alle Volumes der HDD, entfernt ihre Laufwerksbuchstaben aus „Dieser PC“ und fordert Standby an. Die Sperren hält der Windows-Dienst – auch wenn dieses Fenster geschlossen ist. Der Motorzustand wird nicht gemessen; andere Programme oder Treiber können eine HDD trotzdem aufwecken. Kein Ersatz für ein Backup." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
