<WixLocalization Culture="en-US" Codepage="1252" Language="1033" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Language" Value="1033" />
  <String Id="Description" Value="HDD Spindown – Windows service and user interface" />
  <String Id="DowngradeError" Value="A newer version of HDD Spindown is already installed." />
  <String Id="LaunchCondition" Value="HDD Spindown requires Windows 10 or 11 (64-bit)." />
  <String Id="ArpComments" Value="Locks internal SATA data HDDs, hides them and requests standby. Recovery: Service\HddSpindown.Recovery.exe" />
  <String Id="ServiceDescription" Value="Holds volume locks of paused SATA HDDs and restores drive letters after a crash, restart or sleep." />
  <String Id="ShortcutDescription" Value="Pause and release SATA HDDs" />
  <String Id="LaunchApp" Value="Launch HDD Spindown now" />
